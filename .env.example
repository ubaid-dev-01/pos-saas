VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_API_SECRET=
VITE_EMAILJS_PUBLIC_KEY=
# Set to "true" only if you run: firebase emulators:start --only functions
VITE_USE_FUNCTIONS_EMULATOR=false

# Email (receipt PDF, welcome)   Gmail App Password recommended
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-no-spaces
FROM_EMAIL=your-email@gmail.com
SMTP_FROM=QuickPOS <your-email@gmail.com>
SMTP_REPLY_TO=your-email@gmail.com
EMAIL_SERVER_PORT=3001

# Password reset (Firebase Admin)   required for /api/reset-password-with-otp
# Local: place firebase-service-account.json in project root (gitignored)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Vercel: FIREBASE_SERVICE_ACCOUNT_JSON = one-line JSON OR FIREBASE_SERVICE_ACCOUNT_JSON_B64
# Run: npm run firebase:encode-key
FIREBASE_PROJECT_ID=

# Local OTP uses in-memory store (no Firestore). Same dev session for send + reset.
# QUICKPOS_OTP_USE_MEMORY=true
